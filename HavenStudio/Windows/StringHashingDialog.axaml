<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HavenStudio.Windows"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="320"
        x:Class="HavenStudio.Windows.StringHashingDialog"
        Width="500"
        Height="320"
        MinWidth="400"
        MinHeight="250"
        Title="String Hashing"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}">
    <Border Padding="16"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
            <!-- Tab Control -->
            <TabControl Grid.Row="0"
                        x:Name="MainTabControl"
                        SelectedIndex="0"
                        Margin="0,0,0,12">
                <TabItem Header="Hash String">
                    <Grid RowDefinitions="Auto,Auto,Auto" Margin="0,8,0,0">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Input String:"
                                       VerticalAlignment="Center"
                                       Width="100"/>
                            <TextBox x:Name="InputStringBox"
                                     Watermark="Enter text to hash..."
                                     Width="300"/>
                        </StackPanel>

                        <Button Grid.Row="1"
                                Content="Hash"
                                Click="OnHashString"
                                Width="80"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,12"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="Hash:"
                                       VerticalAlignment="Center"
                                       Width="100"/>
                            <TextBox x:Name="HashResultBox"
                                     IsReadOnly="True"
                                     Width="300"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Lookup Hash">
                    <Grid RowDefinitions="Auto,Auto,Auto" Margin="0,8,0,0">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Hash (hex):"
                                       VerticalAlignment="Center"
                                       Width="100"/>
                            <TextBox x:Name="LookupHashBox"
                                     Watermark="e.g. 7A516 or 0x7A516..."
                                     Width="300"/>
                        </StackPanel>

                        <Button Grid.Row="1"
                                Content="Lookup"
                                Click="OnLookupHash"
                                Width="80"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,12"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="Dictionary:"
                                       VerticalAlignment="Center"
                                       Width="100"/>
                            <TextBox x:Name="LookupResultBox"
                                     IsReadOnly="True"
                                     Width="300"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
