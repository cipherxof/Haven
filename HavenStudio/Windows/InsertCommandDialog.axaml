<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HavenStudio.Windows"
        mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="500"
        x:Class="HavenStudio.Windows.InsertCommandDialog"
        x:DataType="local:InsertCommandDialogViewModel"
        Width="550"
        Height="500"
        MinWidth="450"
        MinHeight="400"
        Title="Insert Command"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}">
    <Border Padding="16"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <!-- Insert Mode Selection -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Insert:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding InsertModes}"
                          SelectedIndex="{Binding SelectedInsertModeIndex}"
                          Width="200">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="local:InsertModeItem">
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Command Type Selection -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,0,0,12"
                        IsVisible="{Binding IsCommandMode}">
                <TextBlock Text="Command:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CommandComboBox"
                          ItemsSource="{Binding CommandTypes}"
                          SelectedIndex="{Binding SelectedCommandIndex}"
                          Width="200">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="local:CommandTypeItem">
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,0,0,12"
                        IsVisible="{Binding HasTargetProcedures}">
                <TextBlock Text="Target proc:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding TargetProcedures}"
                          SelectedIndex="{Binding SelectedTargetProcedureIndex}"
                          Width="200"/>
            </StackPanel>

            <!-- Parameters Header -->
            <TextBlock Grid.Row="3"
                       Text="Parameters:"
                       Margin="0,0,0,8"
                       FontWeight="SemiBold"
                       IsVisible="{Binding IsCommandMode}"/>

            <!-- Parameters List -->
            <ScrollViewer Grid.Row="4"
                          Margin="0,0,0,16"
                          Padding="0,0,12,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding IsCommandMode}">
                <ItemsControl ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="local:ParameterViewModel">
                            <Grid ColumnDefinitions="140,*,Auto" Margin="0,0,0,8">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding TextValue}"
                                         IsVisible="{Binding IsTextInput}"
                                         Margin="8,0,0,0"/>
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding BoolValue}"
                                          IsVisible="{Binding IsCheckBox}"
                                          Margin="8,0,0,0"/>
                                <Button Grid.Column="2"
                                        Content="..."
                                        Width="32"
                                        Margin="4,0,0,0"
                                        IsVisible="{Binding IsModelParam}"
                                        Click="OnBrowseModel"
                                        Tag="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Call Proc Inputs -->
            <StackPanel Grid.Row="4"
                        Margin="0,0,0,16"
                        Spacing="8"
                        IsVisible="{Binding IsCallProcMode}">
                <TextBlock Text="Call Proc:" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Proc ID:" VerticalAlignment="Center" Width="80"/>
                    <TextBox Text="{Binding CallProcIdText}" Width="160"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Insert At:" VerticalAlignment="Center" Width="80"/>
                    <ComboBox ItemsSource="{Binding CallProcPositions}"
                              SelectedIndex="{Binding SelectedCallProcPositionIndex}"
                              Width="160">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="local:InsertPositionItem">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="Cancel" Click="OnCancel" Width="80"/>
                <Button Content="Insert" Click="OnInsert" Width="80"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
